# MWIE Environment Configuration
MWIE_HOST=0.0.0.0
MWIE_PORT=8000
MWIE_DEBUG=false

# Crawler Settings
MWIE_USER_AGENT=Mozilla/5.0 (compatible; MolaviWebIntelligence/0.1; +https://molavi.pro/bot)
MWIE_REQUEST_TIMEOUT=20.0
MWIE_MAX_CONCURRENT_CRAWLS=10
MWIE_RESPECT_ROBOTS=true

# Security Settings
MWIE_ALLOW_PRIVATE_IPS=false

# Caching
MWIE_CACHE_ENABLED=true
MWIE_CACHE_TTL=3600
# MWIE_REDIS_URL=redis://localhost:6379/0

# Optional External Adapters
# MWIE_FIRECRAWL_API_URL=https://api.firecrawl.dev
# MWIE_FIRECRAWL_API_KEY=your_key_here
